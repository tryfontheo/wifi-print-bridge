{
  NAME "Read printer capabilities through the bridge"
  OPERATION Get-Printer-Attributes
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR keyword requested-attributes all,media-col-database
  STATUS successful-ok
  EXPECT printer-uri-supported OF-TYPE uri WITH-ALL-VALUES $bridge
  EXPECT document-format-supported OF-TYPE mimeMediaType WITH-VALUE application/pdf
  EXPECT document-format-supported OF-TYPE mimeMediaType WITH-VALUE image/urf
  EXPECT document-format-supported OF-TYPE mimeMediaType WITH-VALUE image/pwg-raster
  EXPECT urf-supported OF-TYPE keyword
  EXPECT printer-is-accepting-jobs WITH-VALUE true
  EXPECT printer-state OF-TYPE enum
}
{
  NAME "Submit a document with Print-Job"
  OPERATION Print-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name bridge-smoke
  ATTR name job-name smoke-print-job
  ATTR mimeMediaType document-format application/pdf
  GROUP job-attributes-tag
  ATTR integer copies 1
  FILE $filename
  STATUS successful-ok
  STATUS successful-ok-ignored-or-substituted-attributes
  EXPECT job-id OF-TYPE integer WITH-VALUE >0
  EXPECT job-uri OF-TYPE uri WITH-HOSTNAME 127.0.0.1
  EXPECT job-uri DEFINE-VALUE first-job-uri
}
{
  NAME "Check the submitted job status using its returned URI"
  OPERATION Get-Job-Attributes
  DELAY "0,1"
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri job-uri $first-job-uri
  ATTR name requesting-user-name bridge-smoke
  STATUS successful-ok
  EXPECT job-uri OF-TYPE uri WITH-VALUE $first-job-uri
  EXPECT job-state OF-TYPE enum WITH-VALUE 9 REPEAT-NO-MATCH REPEAT-LIMIT 8
}
{
  NAME "Create a job for a separate document upload"
  OPERATION Create-Job
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR name requesting-user-name bridge-smoke
  ATTR name job-name smoke-send-document
  STATUS successful-ok
  STATUS successful-ok-ignored-or-substituted-attributes
  EXPECT job-id OF-TYPE integer WITH-VALUE >0
  EXPECT job-id DEFINE-VALUE second-job-id
  EXPECT job-uri OF-TYPE uri WITH-HOSTNAME 127.0.0.1
}
{
  NAME "Send the document and finish the job"
  OPERATION Send-Document
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $second-job-id
  ATTR name requesting-user-name bridge-smoke
  ATTR mimeMediaType document-format application/pdf
  ATTR boolean last-document true
  FILE $filename
  STATUS successful-ok
  STATUS successful-ok-ignored-or-substituted-attributes
}
{
  NAME "Check the uploaded job status using its job ID"
  OPERATION Get-Job-Attributes
  DELAY "0,1"
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $uri
  ATTR integer job-id $second-job-id
  ATTR name requesting-user-name bridge-smoke
  STATUS successful-ok
  EXPECT job-state OF-TYPE enum WITH-VALUE 9 REPEAT-NO-MATCH REPEAT-LIMIT 8
}
